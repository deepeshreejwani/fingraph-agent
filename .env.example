# FinGraph Agent
#
# Public environment-variable reference for both supported profiles:
#
#   .env.dev   -> local development
#   .env.prod  -> managed / production configuration
#
# Private environment files must never be committed.
#
# ------------------------------------------------------------
# Local development setup
# ------------------------------------------------------------
#
# Start from this file:
#
#   cp .env.example .env.dev
#
# Keep the DEVELOPMENT PROFILE below active and fill the credentials
# required by the workflows you intend to run.
#
# Load it into your current shell with:
#
#   set -a
#   source .env.dev
#   set +a
#
# ------------------------------------------------------------
# Production / managed setup
# ------------------------------------------------------------
#
# Create `.env.prod` privately using the commented PRODUCTION PROFILE
# later in this file.
#
# Load it locally when you intentionally want to use managed services:
#
#   set -a
#   source .env.prod
#   set +a
#
# Railway does not automatically read `.env.prod` from your computer.
# Production variables must also be configured in the Railway service.
#
# Railway:
# https://railway.com/project/
#
# IMPORTANT:
#
# - Never commit `.env.dev` or `.env.prod`.
# - Never place real credentials in `.env.example`.
# - Values below are safe defaults, placeholders, or format examples.
# - `.env.example` itself should not contain usable credentials.
#
# Typical development stack:
#
# - local Neo4j
# - local Qdrant
# - Groq
# - optional Langfuse
#
# Typical production stack:
#
# - Neo4j Aura
# - Qdrant Cloud
# - Groq
# - optional Langfuse
# - FinGraph API access key
# - persistent Railway SQLite state under /data


# ============================================================
# DEVELOPMENT PROFILE — .env.dev
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

FINGRAPH_ENVIRONMENT=development
FINGRAPH_LOG_LEVEL=INFO


# ------------------------------------------------------------
# SEC EDGAR
# ------------------------------------------------------------

# Required only when running SEC ingestion.
#
# SEC automated access should identify the application and provide
# a real contact email.
#
# Example format:
# FINGRAPH_SEC_USER_AGENT="FinGraph Agent your-email@example.com"
FINGRAPH_SEC_USER_AGENT=


# ------------------------------------------------------------
# Neo4j — local
# ------------------------------------------------------------

FINGRAPH_NEO4J_URI=bolt://localhost:7687
FINGRAPH_NEO4J_USER=neo4j

# Required for local Docker Compose / graph-backed API execution.
# Choose your own local Neo4j password.
FINGRAPH_NEO4J_PASSWORD=

FINGRAPH_NEO4J_DATABASE=neo4j

FINGRAPH_NEO4J_READ_TIMEOUT_SECONDS=10
FINGRAPH_NEO4J_CONNECTION_TIMEOUT_SECONDS=3
FINGRAPH_NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=3


# ------------------------------------------------------------
# Qdrant — local
# ------------------------------------------------------------

FINGRAPH_QDRANT_URL=http://localhost:6333

# Leave empty for the project's unauthenticated local Qdrant setup.
FINGRAPH_QDRANT_API_KEY=

FINGRAPH_QDRANT_COLLECTION=fingraph_chunks


# ------------------------------------------------------------
# LLM — Groq
# ------------------------------------------------------------

# Required for LLM-backed workflows such as:
#
# - Text-to-Cypher generation
# - Cypher repair
# - grounded answer synthesis
# - LLM-backed evaluation
#
# Create/manage Groq API keys:
# https://console.groq.com/keys
#
# Example key prefix only:
# gsk_...
FINGRAPH_GROQ_API_KEY=

FINGRAPH_LLM_PROVIDER=groq
FINGRAPH_LLM_MODEL=openai/gpt-oss-120b
FINGRAPH_LLM_REASONING_EFFORT=low

# Local durable execution-state database.
FINGRAPH_LLM_STATE_DB_PATH=data/state/fingraph_runs.db

FINGRAPH_LLM_INFRASTRUCTURE_MAX_ATTEMPTS=4
FINGRAPH_LLM_MAX_RETRY_WAIT_SECONDS=30
FINGRAPH_LLM_SYNTHESIS_INPUT_TOKEN_BUDGET=16000


# ------------------------------------------------------------
# Graph QA
# ------------------------------------------------------------

FINGRAPH_GRAPH_QA_MAX_ATTEMPTS=2
FINGRAPH_GRAPH_QA_MAX_ROWS=25


# ------------------------------------------------------------
# API — local
# ------------------------------------------------------------

FINGRAPH_API_HOST=127.0.0.1
FINGRAPH_API_PORT=8000

FINGRAPH_API_REQUEST_TIMEOUT_SECONDS=90
FINGRAPH_API_QUEUE_TIMEOUT_SECONDS=5
FINGRAPH_API_READINESS_TIMEOUT_SECONDS=3
FINGRAPH_API_MAX_CONCURRENCY=4
FINGRAPH_API_EVIDENCE_LIMIT=5

# Optional in development/test.
#
# Production requires a non-empty FinGraph API access key.
FINGRAPH_API_ACCESS_KEY=

FINGRAPH_API_RATE_LIMIT_REQUESTS_PER_MINUTE=30


# ------------------------------------------------------------
# Langfuse — optional
# ------------------------------------------------------------

# Create/manage your Langfuse account/project:
# https://cloud.langfuse.com/
#
# Set to true only when you have configured both project keys.
FINGRAPH_LANGFUSE_ENABLED=false

# Example formats only:
#
# public key: pk-lf-...
# secret key: sk-lf-...
FINGRAPH_LANGFUSE_PUBLIC_KEY=
FINGRAPH_LANGFUSE_SECRET_KEY=

FINGRAPH_LANGFUSE_BASE_URL=https://cloud.langfuse.com


# ------------------------------------------------------------
# Load testing — optional
# ------------------------------------------------------------

# Used only by the Locust load-test harness.
#
# route:
#   vector
#   graph
#   hybrid
#
# mode:
#   sync
#   stream
FINGRAPH_LOAD_ROUTE=vector
FINGRAPH_LOAD_MODE=sync
FINGRAPH_LOAD_HOST=http://localhost:8000


# ============================================================
# PRODUCTION PROFILE — .env.prod
# ============================================================
#
# The production profile below is intentionally COMMENTED OUT.
#
# Copy the required lines into a private `.env.prod` file and replace
# placeholders with your own credentials.
#
# Do not uncomment both development and production profiles in this
# public example at the same time.
#
#
# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
#
# FINGRAPH_ENVIRONMENT=production
# FINGRAPH_LOG_LEVEL=INFO
#
#
# ------------------------------------------------------------
# SEC EDGAR
# ------------------------------------------------------------
#
# Required when production/managed workflows perform SEC ingestion.
#
# Example:
# FINGRAPH_SEC_USER_AGENT="FinGraph Agent your-email@example.com"
#
# FINGRAPH_SEC_USER_AGENT=
#
#
# ------------------------------------------------------------
# Neo4j Aura
# ------------------------------------------------------------
#
# Create/manage your Aura project and database:
# https://console.neo4j.io/projects/
#
# Use the DATABASE CONNECTION credentials supplied for the AuraDB
# instance. These are not Neo4j management/API OAuth credentials.
#
# Example URI format only:
# neo4j+s://<instance-id>.databases.neo4j.io
#
# FINGRAPH_NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# FINGRAPH_NEO4J_USER=
# FINGRAPH_NEO4J_PASSWORD=
# FINGRAPH_NEO4J_DATABASE=
#
# FINGRAPH_NEO4J_READ_TIMEOUT_SECONDS=10
# FINGRAPH_NEO4J_CONNECTION_TIMEOUT_SECONDS=10
# FINGRAPH_NEO4J_MAX_TRANSACTION_RETRY_TIME_SECONDS=10
#
#
# ------------------------------------------------------------
# Qdrant Cloud
# ------------------------------------------------------------
#
# Create/manage your account and cluster:
# https://cloud.qdrant.io/accounts/
#
# Replace the URL placeholder with your own cluster endpoint.
#
# Example URL format only:
# https://<cluster-id>.<region>.<provider>.cloud.qdrant.io
#
# FINGRAPH_QDRANT_URL=https://<cluster-id>.<region>.<provider>.cloud.qdrant.io
# FINGRAPH_QDRANT_API_KEY=
# FINGRAPH_QDRANT_COLLECTION=fingraph_chunks
#
#
# ------------------------------------------------------------
# LLM — Groq
# ------------------------------------------------------------
#
# Create/manage Groq API keys:
# https://console.groq.com/keys
#
# Example key prefix only:
# gsk_...
#
# FINGRAPH_GROQ_API_KEY=
#
# FINGRAPH_LLM_PROVIDER=groq
# FINGRAPH_LLM_MODEL=openai/gpt-oss-120b
# FINGRAPH_LLM_REASONING_EFFORT=low
#
# Railway production uses the persistent volume mounted at /data.
#
# FINGRAPH_LLM_STATE_DB_PATH=/data/fingraph_runs.db
#
# FINGRAPH_LLM_INFRASTRUCTURE_MAX_ATTEMPTS=4
# FINGRAPH_LLM_MAX_RETRY_WAIT_SECONDS=30
# FINGRAPH_LLM_SYNTHESIS_INPUT_TOKEN_BUDGET=16000
#
#
# ------------------------------------------------------------
# Graph QA
# ------------------------------------------------------------
#
# FINGRAPH_GRAPH_QA_MAX_ATTEMPTS=2
# FINGRAPH_GRAPH_QA_MAX_ROWS=25
#
#
# ------------------------------------------------------------
# API — production
# ------------------------------------------------------------
#
# Railway/container runtime may override host binding as required.
#
# FINGRAPH_API_HOST=0.0.0.0
# FINGRAPH_API_PORT=8000
#
# FINGRAPH_API_REQUEST_TIMEOUT_SECONDS=90
# FINGRAPH_API_QUEUE_TIMEOUT_SECONDS=5
# FINGRAPH_API_READINESS_TIMEOUT_SECONDS=5
# FINGRAPH_API_MAX_CONCURRENCY=4
# FINGRAPH_API_EVIDENCE_LIMIT=5
#
# Required when FINGRAPH_ENVIRONMENT=production.
#
# This is FinGraph's own application access key.
# It is NOT a Railway account/project API token.
#
# Generate your own random secret, for example:
#
#   openssl rand -hex 32
#
# Store the generated value privately in `.env.prod` and in the
# Railway production service variables.
#
# FINGRAPH_API_ACCESS_KEY=
#
# FINGRAPH_API_RATE_LIMIT_REQUESTS_PER_MINUTE=30
#
#
# ------------------------------------------------------------
# Langfuse — optional production observability
# ------------------------------------------------------------
#
# Create/manage your Langfuse account/project:
# https://cloud.langfuse.com/
#
# Enable only when both project keys are configured.
#
# FINGRAPH_LANGFUSE_ENABLED=true
#
# Example formats only:
#
# public key: pk-lf-...
# secret key: sk-lf-...
#
# FINGRAPH_LANGFUSE_PUBLIC_KEY=
# FINGRAPH_LANGFUSE_SECRET_KEY=
# FINGRAPH_LANGFUSE_BASE_URL=https://cloud.langfuse.com
#
#
# ------------------------------------------------------------
# Load testing — optional
# ------------------------------------------------------------
#
# The current Phase-1 Locust harness does not send X-API-Key.
# Use it only with a local or otherwise unprotected test endpoint.
#
# FINGRAPH_LOAD_ROUTE=vector
# FINGRAPH_LOAD_MODE=sync
# FINGRAPH_LOAD_HOST=http://localhost:8000